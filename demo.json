      "body": {"suffix": "{{request.pathSuffix}}"}
    },
    {
      "method": "GET",
      "path": "/files/images/",
      "pathMode": "prefix",
      "bodyMode": "template",
      "body": {"suffix": "{{request.pathSuffix}}"}
